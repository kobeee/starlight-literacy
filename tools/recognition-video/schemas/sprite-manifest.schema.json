{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight-literacy.local/schemas/recognition-video/sprite-manifest.schema.json",
  "title": "Recognition Video Sprite Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "characterId",
    "actor",
    "action",
    "fps",
    "frameSize",
    "playback",
    "alphaRequired",
    "minFrames",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "recognition-video-sprite/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 24
    },
    "frameSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 8
        },
        "height": {
          "type": "integer",
          "minimum": 8
        }
      }
    },
    "pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "holdLastFrame"],
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "holdLastFrame": {
          "type": "boolean"
        }
      }
    },
    "alphaRequired": {
      "type": "boolean",
      "const": true
    },
    "generationMode": {
      "type": "string",
      "enum": ["transparent", "chroma-key"]
    },
    "sourceTransparency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transparentPixelRatio", "edgeTransparentRatio", "hasUsableAlpha"],
      "properties": {
        "transparentPixelRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edgeTransparentRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hasUsableAlpha": {
          "type": "boolean"
        }
      }
    },
    "chromaKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "color"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "minFrames": {
      "type": "integer",
      "minimum": 4
    },
    "frames": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "pattern": "^.+\\.png$"
      }
    },
    "poseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredMotionParts", "frames"],
      "properties": {
        "requiredMotionParts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frames": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "pose", "contact"],
            "properties": {
              "frame": {
                "type": "integer",
                "minimum": 0
              },
              "pose": {
                "type": "string",
                "minLength": 4
              },
              "contact": {
                "type": "string",
                "minLength": 4
              }
            }
          }
        }
      }
    },
    "motionChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "region", "minChangedFramePairs", "minChangedPixels", "minMeanDelta"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "$ref": "#/$defs/region"
          },
          "minChangedFramePairs": {
            "type": "integer",
            "minimum": 1
          },
          "minChangedPixels": {
            "type": "integer",
            "minimum": 1
          },
          "minMeanDelta": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
