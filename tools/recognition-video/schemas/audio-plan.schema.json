{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlight-literacy.local/schemas/recognition-video/audio-plan.schema.json",
  "title": "Recognition Video Audio Sync Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "characterId",
    "script",
    "voice",
    "durationBenchmark",
    "targetDurationSeconds",
    "cues",
    "syncRules",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "recognition-video-audio-plan/v1"
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "script": {
      "type": "string",
      "minLength": 4
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "voice", "rate", "pitch", "rationale"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2
        },
        "voice": {
          "type": "string",
          "minLength": 2
        },
        "rate": {
          "type": "string",
          "pattern": "^[+-]?[0-9]+(\\.[0-9]+)?%$"
        },
        "pitch": {
          "type": "string",
          "minLength": 2
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "durationBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceModel",
        "referenceProduct",
        "referenceDurationSeconds",
        "referenceEvidence",
        "starlightTargetSeconds",
        "starlightDecision"
      ],
      "properties": {
        "sourceModel": {
          "type": "string",
          "minLength": 4
        },
        "referenceProduct": {
          "type": "string",
          "minLength": 4
        },
        "referenceDurationSeconds": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max", "example"],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 1
                },
                "max": {
                  "type": "number",
                  "minimum": 1
                },
                "example": {
                  "type": "number",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "referenceEvidence": {
          "type": "string",
          "minLength": 8
        },
        "starlightTargetSeconds": {
          "type": "number",
          "minimum": 3,
          "maximum": 8
        },
        "starlightDecision": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "targetDurationSeconds": {
      "type": "number",
      "minimum": 3,
      "maximum": 8
    },
    "rawTtsAudioDurationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "bakedAudioDurationSeconds": {
      "type": "number",
      "minimum": 0
    },
    "quietAfterLastCueSeconds": {
      "type": "number",
      "minimum": 0
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "audioStart", "audioEnd", "visualStart", "visualEnd"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "shotId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "audioStart": {
            "type": "number",
            "minimum": 0
          },
          "audioEnd": {
            "type": "number",
            "minimum": 0
          },
          "visualStart": {
            "type": "number",
            "minimum": 0
          },
          "visualEnd": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "syncRules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio", "subtitles"],
      "properties": {
        "audio": {
          "type": "string",
          "minLength": 1
        },
        "rawAudio": {
          "type": "string"
        },
        "subtitles": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
