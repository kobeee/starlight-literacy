{
  "schemaVersion": "recognition-video-narration-spec/v1",
  "characterId": "yi-v7",
  "targetCharacter": "一",
  "targetCharSemantic": "number",
  "script": "看，一只小鸟。飞过一道光。这就是一。",
  "segments": [
    {
      "id": "concrete-anchor",
      "text": "看，一只小鸟。",
      "role": "concrete-anchor",
      "targetCharOccurrences": 1,
      "shotIdHint": "bird-pass",
      "notes": "v7 第一句旁白，邀请孩子去看 → 复用 v5 cinematic 已生产的 bird-flight-loop sprite（6 帧、transparentPixelRatio 0.9446）；小鸟从右下飞向左上、掠过米字格上方；「一只」= 可数 1 个，给 number-as-numeral 一个具象锚点。"
    },
    {
      "id": "phrase-bridge",
      "text": "飞过一道光。",
      "role": "phrase-bridge",
      "targetCharOccurrences": 1,
      "shotIdHint": "light-band",
      "notes": "鸟飞过留下的轨迹凝固成一道横向暖金光带；用「一道光」复用同一个量词模式，且画面就只有 1 道光带，boundToVisualCount=true 有视觉计数锚。这一段 v7 让光带在「米字格上方一格」的位置出现，为下一秒下沉进米字格中横位做铺垫——所以光带本身就是「一」字横笔的预演。"
    },
    {
      "id": "glyph-naming",
      "text": "这就是一。",
      "role": "glyph-naming",
      "targetCharOccurrences": 1,
      "shotIdHint": "ink-glyph",
      "notes": "光带下沉到米字格正中、慢慢变成黑色楷体「一」字时口播说出「这就是一」；「一」作为单字念出时配合 0.4s 停顿强调字音，建立 字-形-音 三绑定。砍掉 v6「念，一」的指令式口吻——3-6 岁听不懂「念」是什么意思。v7 用「这就是一」+ 字音延长，更自然。"
    }
  ],
  "concreteAnchorPhrase": {
    "segmentId": "concrete-anchor",
    "phrase": "一只小鸟",
    "anchorObject": "小鸟"
  },
  "quantifierUsage": [
    {
      "segmentId": "concrete-anchor",
      "phrase": "一只",
      "kind": "number-as-numeral",
      "boundToVisualCount": true,
      "visualReference": "bird-pass shot / bird-flight-loop sprite（画面单只小鸟剪影，可数 1 只）"
    },
    {
      "segmentId": "phrase-bridge",
      "phrase": "一道",
      "kind": "number-as-quantifier",
      "boundToVisualCount": true,
      "visualReference": "light-band shot / 单一条横向暖金光带 CSS div（画面就 1 道光，可数 1 道）"
    }
  ],
  "voice": {
    "provider": "edge-tts",
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "pitch": "+0Hz",
    "rationale": "继承 v3/v4/v5/v6 同一 Xiaoxiao 女老师声 + -10% 慢速；v7 重构叙事 + 视觉但保留声线，让孩子在跨版本时听感连续。"
  },
  "tts": {
    "engine": "edge-tts",
    "commandTemplate": "edge-tts --voice {{voice}} --rate={{rate}} --pitch={{pitch}} --text {{text}} --write-media {{audioOut}} --write-subtitles {{subtitleOut}}",
    "postProcess": {
      "apadToSeconds": 12
    }
  },
  "outputs": {
    "audio": "src/clients/mobile-h5/assets/recognition/yi/yi-v7-narration.mp3",
    "rawAudio": "src/clients/mobile-h5/assets/recognition/yi/yi-v7-narration-raw.mp3",
    "subtitles": "src/clients/mobile-h5/assets/recognition/yi/yi-v7-narration.vtt",
    "measuredTimings": "src/clients/mobile-h5/assets/recognition/yi/yi-v7-narration.measured-timings.json"
  }
}
